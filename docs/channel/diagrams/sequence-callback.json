    { "participant": "svc", "from": 298, "to": 458, "type": "backend" },
    { "participant": "adp", "from": 340, "to": 410, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "资金安全边界",
      "items": [
        "验签只发生在 adapter 层，gateway 与 channel 业务层不碰签名",
        "签名不符返回 40003，报文状态未知返回 40004",
        "报文无法解析返回 40005"
      ]
    },
    {
      "dot": "emerald",
      "title": "金额口径",
      "items": [
        "成功回调取 real_price（实收），失败回调取 order_price（原单）",
        "payapay 既有口径，代付失败状态 3/7/9 均映射为失败",
        "金额单位一律为分"
      ]
    },
    {
      "dot": "orange",
      "title": "回执与重试",
      "items": [
        "验签通过 gateway 才按 callback_return 应答 success",
        "失败应答渠道侧会重推，靠幂等消化",
        "无回调渠道（neokred 形态）返回 10001，状态靠对账轮询"
      ]
    }
  ]
