{
  "openapi": "3.1.0",
  "info": {
    "title": "user",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/users": {
      "post": {
        "tags": [
          "UserService"
        ],
        "summary": "创建用户",
        "description": "邮箱全局唯一，已被占用时返回 AlreadyExists；参数校验失败返回 InvalidArgument 并附带违规字段明细。",
        "operationId": "UserService_CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "邮箱，须为合法邮箱格式。"
                  },
                  "name": {
                    "type": "string",
                    "description": "用户名，1~32 字符。"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "创建用户的出参。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.CreateUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{id}": {
      "get": {
        "tags": [
          "UserService"
        ],
        "summary": "按 ID 取用户",
        "description": "用户不存在时返回 NotFound。",
        "operationId": "UserService_GetUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "用户 ID，须为正数。",
            "required": true,
            "schema": {
              "type": "string",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "取用户的出参。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.GetUserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "google.rpc.Status": {
        "type": "object",
        "description": "The Status type defines a logical error model suitable for different programming environments.",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "The status code, which should be an enum value of google.rpc.Code."
          },
          "details": {
            "type": "array",
            "description": "A list of messages that carry the error details.",
            "items": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "message": {
            "type": "string",
            "description": "A developer-facing error message."
          }
        }
      },
      "user.v1.CreateUserResponse": {
        "type": "object",
        "description": "创建用户的出参。",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user.v1.User",
            "description": "新建的用户。"
          }
        }
      },
      "user.v1.GetUserResponse": {
        "type": "object",
        "description": "取用户的出参。",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user.v1.User",
            "description": "查到的用户。"
          }
        }
      },
      "user.v1.User": {
        "type": "object",
        "description": "用户",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间，由数据库默认值填充。"
          },
          "email": {
            "type": "string",
            "description": "邮箱，全局唯一。"
          },
          "id": {
            "type": "string",
            "format": "int64",
            "description": "用户 ID，创建时由服务端分配。"
          },
          "name": {
            "type": "string",
            "description": "用户名，1~32 字符。"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "UserService",
      "description": "用户服务\n\n用户的创建与查询。错误统一以 google.rpc.Status 返回，HTTP 状态码由 gateway 映射。"
    }
  ]
}